# Virtual Environment
.venv/
env/
venv/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

# Raw and Processed Datasets (keep original archives / large datasets local)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Environment variables & secrets
.env
*.env
*.log

# Power BI local backups
*.tmp
*.pbix.backup
